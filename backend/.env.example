# Server
NODE_ENV=development
PORT=4000
# Comma-separated exact browser origins. Use your production origin in deployment.
CORS_ORIGIN=http://localhost:5173

# Database (required once a Prisma data model is introduced)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Authentication (server-only; do not use example values in production)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=pictapdf_auth
AUTH_COOKIE_MAX_AGE_MS=604800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Supabase Storage (server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=image-to-pdf
